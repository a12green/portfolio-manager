GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Portfolio holdings worksheet (broker export layout used by Stocks.csv example).
GOOGLE_SHEET_NAME=Portfolio

# Optional: local CSV for development (same columns as the sheet). Used when GOOGLE_SHEETS_SPREADSHEET_ID is unset.
# PORTFOLIO_CSV_PATH=./Stocks.csv

# SQLite history for charts/PDF (created automatically).
STORAGE_DB_PATH=data/portfolio_history.sqlite3

# Live stock prices for GUI heat map, portfolio refresh, and trade reports (Yahoo Finance, ~15 min delay).
# Set false to use only last --snapshot-stocks-daily / sheet prices.
# Automatic polls are skipped on US (NYSE) and Australian (ASX) holidays when MARKET_HOLIDAYS_ENABLED=true.
# The GUI refreshes the active price tab every LIVE_QUOTES_POLL_SEC while NYSE or ASX is open.
LIVE_QUOTES=true
LIVE_QUOTES_POLL_SEC=60
LIVE_QUOTES_CACHE_SEC=55
MARKET_HOLIDAYS_ENABLED=true

# Fund List weekly snapshot (same spreadsheet ID). OWNER_A sums OWNER_A_FUND_ROWS for cols I/K; OWNER_B/OWNER_C use single rows.
GOOGLE_FUND_LIST_SHEET_NAME=Fund List
OWNER_A_FUND_ROWS=2:9
OWNER_B_FUND_ROW=10
OWNER_C_FUND_ROW=11
FUND_COL_I=I
FUND_COL_K=K

# PDF output path for --pdf-report
PDF_OUTPUT_PATH=reports/portfolio_report.pdf

# When true: holdings email attaches PDF_OUTPUT_PATH if it exists; standalone --pdf-report emails the PDF alone.
EMAIL_ATTACH_PDF=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient@example.com
EMAIL_SUBJECT=Portfolio Progress Update

# Option near-strike alerts (run via --check-option-strike-alerts or strike_alert_runner.sh)
OPTION_STRIKE_ALERT_ENABLED=true
OPTION_STRIKE_ALERT_TO=recipient@example.com
OPTION_STRIKE_THRESHOLD=1.0
OPTION_STRIKE_ALERT_SUBJECT=Option near strike alert

# Web UI (python -m web  or  python main.py --serve-web)
# 127.0.0.1 keeps the app on this machine. Docker sets 0.0.0.0 itself.
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Secure by default: session cookies are sent only over HTTPS. Use false only for plain-HTTP local use.
WEB_SECURE_COOKIES=true
# Session lifetime in hours (default 12).
WEB_SESSION_HOURS=12
# Public base URL of the web UI. Used to build the link in password-reset emails.
WEB_PUBLIC_URL=http://localhost:8080
# How long a password-reset link stays valid, in minutes (default 30).
WEB_RESET_TOKEN_MINUTES=30

# Set true only when a reverse proxy you run sets X-Forwarded-For. Otherwise the header is ignored.
# Sign-in rate limits key on the client address, so trusting an unset header lets callers bypass them.
WEB_TRUST_PROXY=false
